# =============================================================================
# Nashaa (learning-tree-connect) - environment variables
# Copy this file to .env for local development, or enter these as
# environment variables in your Railway / Render project settings.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED - app will not start / core features will not work without these
# ---------------------------------------------------------------------------

# Runtime mode. Use "production" on Railway/Render.
NODE_ENV=production

# Port the Express server listens on. Railway/Render set this automatically;
# you usually don't need to set it yourself on those platforms.
PORT=3000

# MySQL connection string. Railway and Render both provide a MySQL add-on
# that gives you this URL directly (format: mysql://user:password@host:port/database).
DATABASE_URL=mysql://user:password@host:3306/nashaa

# Secret used to sign session/login cookies (JWT). Use a long random string,
# e.g. generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Public base URL of your deployed app, used in email links etc.
APP_URL=https://naashah.com

# ---------------------------------------------------------------------------
# REQUIRED for image/file uploads (child photos, center logo, documents)
# Any S3-compatible object storage works: Amazon S3, Cloudflare R2,
# Backblaze B2, or self-hosted MinIO.
# ---------------------------------------------------------------------------

S3_BUCKET=nashaa-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Only needed for non-AWS providers (Cloudflare R2, Backblaze B2, MinIO).
# Leave blank if using real Amazon S3.
S3_ENDPOINT=
# Set to "true" for providers that require path-style URLs (R2, MinIO,
# most self-hosted setups). Leave blank/false for real AWS S3.
S3_FORCE_PATH_STYLE=

# ---------------------------------------------------------------------------
# OPTIONAL - Email notifications (invoices, announcements, password reset)
# Leave EMAIL_ENABLED unset/true and fill in either the SMTP block or the
# SendGrid key, matching EMAIL_PROVIDER. If neither is configured, the app
# logs a warning and skips sending email instead of crashing.
# ---------------------------------------------------------------------------

EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@naashah.com
EMAIL_FROM_NAME=Nashaa

# EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL - SMS notifications (Twilio)
# ---------------------------------------------------------------------------

SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# OPTIONAL - Web push notifications
# Generate a VAPID key pair with: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL - Payments (Moyasar, a Saudi payment gateway)
# ---------------------------------------------------------------------------

MOYASAR_API_KEY=
MOYASAR_SECRET_KEY=
# This one is used by the frontend build (Vite), not just the server.
VITE_MOYASAR_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL - Marketing integrations
# ---------------------------------------------------------------------------

META_CAPI_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# OPTIONAL but RECOMMENDED - new registration / demo-request alerts
# When a parent registers a new nursery or requests a demo, the app tries to
# notify you (the project owner). On Manus this went through Manus's own
# notification service; outside Manus, set this address and the app will
# email you there instead (using the SMTP/SendGrid config above). If this
# is blank and email isn't configured either, the alert is silently
# skipped -- the registration/demo request itself still succeeds either way.
# ---------------------------------------------------------------------------

ADMIN_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# REQUIRED once running outside Manus - protects the cron endpoints
# The app has 6 routes under /api/scheduled/* (daily backup, pickup
# escalation, event reminders, account cleanup, enrollment expiry,
# evaluation reminders) meant to be called on a schedule. On Manus, only
# Manus's own internal scheduler could reach them. Outside Manus they're
# exposed on your public domain, so set this and configure your external
# cron (see DEPLOYMENT.md) to send `Authorization: Bearer <this value>`.
# If left blank the routes still work but are unauthenticated -- anyone who
# finds the URL could trigger them.
# ---------------------------------------------------------------------------

CRON_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL - AI features (weekly plans, development/engagement suggestions,
# marketing content generation). These went through Manus's built-in LLM
# proxy; set a real OpenAI key to keep them working outside Manus. Without
# this, these specific AI features return an error when used, everything
# else in the app is unaffected.
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
# Only needed to point at a different OpenAI-compatible provider.
OPENAI_API_URL=https://api.openai.com
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# LEGACY / NOT USED - left over from this project's Manus origins.
# ---------------------------------------------------------------------------

# The app now uses its own independent email/password login (JWT session
# cookies) instead of Manus's OAuth. registerOAuthRoutes() is never called,
# so these three are dead and can be left blank.
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=

# Manus's own "Forge" gateway key/URL. Object storage and AI chat no longer
# need this (see S3_* and OPENAI_* above). Two unused files still reference
# it if BUILT_IN_FORGE_API_URL/KEY happen to be set (server/_core/map.ts, a
# Google Maps proxy, and server/_core/voiceTranscription.ts, a
# speech-to-text helper) -- neither is called from anywhere in the app
# today. server/_core/imageGeneration.ts (AI poster background generation,
# used only by the optional poster-maker feature in
# server/posterGenerator.ts) *is* still called, and *does* still need this
# -- it talks to a Manus-specific image-generation protocol that has no
# drop-in replacement, so that one feature will error out once these are
# unset. Leave BUILT_IN_FORGE_API_URL/KEY blank unless you specifically
# still have Manus Forge access and want the poster generator to keep
# working.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
